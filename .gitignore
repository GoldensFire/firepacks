node_modules/

# Ключи. В репозитории им не место ни в каком виде.
data/*.txt
.dev.vars

# База и обложки: собираются дома, весят десятки мегабайт. Между ночами они
# лежат приложением к отметке релиза, а не в истории правок (см. scripts/state.js).
data/sibase.db
data/sibase.db-shm
data/sibase.db-wal
data/logos/
data/thumbs/
data/state.tgz
data/state-stage/

# Прежняя здешняя база, отодвинутая сверкой, и отметка о том, какой свёрток
# с полки здесь развёрнут: и то, и другое своё у каждой машины.
data/sibase.prev.db
data/state-mark.json

# Отчёты о ночных обходах: у каждой машины свои
data/nightly/

# Вывод разовых запусков индексатора, отложенный в файл
data/*.log

# Всё, что собирается для Cloudflare: перезаписывается каждой выкладкой
cf/public/
cf/data/
.wrangler/
