@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo Открываю страницу обновления базы.
echo Там можно отметить, что именно обновлять: ссылки из ВК, разбор паков,
echo статистику, проценты категорий, краткие описания.
echo Окно не закрывайте — на нём держится сайт.
echo.
echo Всё посчитанное тем же запуском уезжает на сайт: база одна,
echo отдельно её выкладывать больше не нужно.
echo.
echo Сначала сверяю базу с сайтом: обновлять вчерашнюю копию незачем.
echo.
node --no-warnings scripts\start.js --open --page=/update
pause
